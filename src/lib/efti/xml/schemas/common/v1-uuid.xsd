<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://efti.fi/v1/common"
        elementFormDefault="qualified">

    <xsd:simpleType name="UUID">
        <xsd:restriction base="xsd:string">
            <!-- https://www.rfc-editor.org/rfc/rfc9562.html#name-uuid-format -->
            <!-- Requires UUID version 4 (RFC 9562-4) -->
            <xsd:pattern value="[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}"/>
        </xsd:restriction>
    </xsd:simpleType>
</xsd:schema>
