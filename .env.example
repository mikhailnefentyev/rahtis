# ─────────────────────────────────────────────────────────────
# RAHTIS — переменные окружения
#
# Скопируйте этот файл в .env.local и заполните значениями своего
# проекта Supabase: Project Settings → API Keys.
# .env.local в git не попадает.
#
# Ключи нового формата (sb_publishable_… / sb_secret_…). Это не JWT —
# legacy-ключи anon и service_role здесь не используются.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_…). Ранее назывался anon.
# Попадает в браузерный бандл — это нормально: доступ ограничивают
# политики RLS, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). Ранее назывался service_role.
# СЕКРЕТ: обходит RLS полностью. Только серверный код,
# см. src/lib/supabase/admin.ts и src/lib/env.server.ts.
# Никогда не добавляйте к имени префикс NEXT_PUBLIC_ — это отправит ключ
# в браузер и откроет всю базу любому посетителю.
SUPABASE_SECRET_KEY=

# Базовый адрес приложения: ссылки в письмах, редиректы после входа.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Карты и маршруты
# ─────────────────────────────────────────────────────────────

# TomTom: расчёт пробега по дорогам для грузовика, геокодинг, подсказка
# адресов. developer.tomtom.com → Register → создать проект.
# СЕКРЕТ: только сервер. Без префикса NEXT_PUBLIC_ — иначе ключ уедет
# в браузер, и за чужие вызовы заплатим мы.
# Без него километраж вводится вручную, остальное работает.
TOMTOM_KEY=

# MapTiler: фон карты маршрута. cloud.maptiler.com → создать ключ.
# Публичный по устройству: тайлы грузит браузер, поэтому ключ обязан
# быть в бандле. Защита не в секретности, а в ограничении по домену —
# задайте разрешённые источники в панели MapTiler, иначе чужой сайт
# израсходует наш лимит.
# Без него карта просто не показывается, маршрут читается списком точек.
NEXT_PUBLIC_MAPTILER_KEY=

# ── Почта ───────────────────────────────────────────────────────────
# stub — письма собираются и ложатся в email_outbox, но не отправляются.
# resend — реальная отправка. Переключение провайдера это одна строка.
EMAIL_PROVIDER=stub
EMAIL_FROM="RAHTIS <noreply@aipoweredsolutions.fi>"
EMAIL_REPLY_TO=info@aipoweredsolutions.fi
EMAIL_OPERATOR=info@aipoweredsolutions.fi
# Заполнится, когда подключим Resend.
RESEND_API_KEY=
