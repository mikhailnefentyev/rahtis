# ─────────────────────────────────────────────────────────────
# RAHTIS — переменные окружения
#
# Скопируйте этот файл в .env.local и заполните значениями своего
# проекта Supabase: панель проекта → Settings → API.
# .env.local в git не попадает.
# ─────────────────────────────────────────────────────────────

# Публичные значения: попадают в браузерный бандл, это нормально.
# Доступ ограничен политиками RLS, а не секретностью ключа.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# СЕКРЕТ. Обходит RLS полностью.
# Только серверный код (см. src/lib/supabase/admin.ts).
# Никогда не добавляйте к имени префикс NEXT_PUBLIC_ — это отправит ключ
# в браузер и откроет всю базу любому посетителю.
SUPABASE_SERVICE_ROLE_KEY=

# Базовый адрес приложения: ссылки в письмах, редиректы после входа.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
